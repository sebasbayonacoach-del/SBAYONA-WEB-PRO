# BAYONA · variables públicas de Vite
# Copia a .env.local en desarrollo o configúralas en el proveedor de despliegue.

# Dominio canónico.
VITE_SITE_URL=https://bayona-jet.vercel.app

# Captación cloud. Son URL y anon key públicas de Supabase, nunca service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Agenda real (Calendly, TidyCal u otro https://...). Si queda vacío,
# la web usa WhatsApp como fallback y no finge una reserva automática.
VITE_BOOKING_URL=


# STRIPE SANDBOX · solo backend / Vercel Functions. No prefijo VITE_.
# El sandbox permanece apagado salvo que se configure explícitamente.
# Nunca agregues claves reales o test a este archivo ni al repositorio.
BAYONA_STRIPE_SANDBOX_ENABLED=false
BAYONA_STRIPE_RETURN_ORIGIN=
# STRIPE_SECRET_KEY=<solo en secretos del servidor de Vercel, sk_test_...>
# Este endpoint no procesa cobros reales ni habilita membresías.

# STRIPE_WEBHOOK_SECRET=whsec_...  # Solo en staging y secretos de backend
# El webhook responde 503 a pagos válidos hasta existir almacenamiento idempotente.
