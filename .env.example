# BAYONA · variables públicas de Vite
# Copia a .env.local en desarrollo o configúralas en el proveedor de despliegue.

# Dominio canónico.
VITE_SITE_URL=https://bayona-jet.vercel.app

# Captación cloud. Son URL y anon key públicas de Supabase, nunca service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Agenda real (Calendly, TidyCal u otro https://...). Si queda vacío,
# la web usa WhatsApp como fallback y no finge una reserva automática.
VITE_BOOKING_URL=
